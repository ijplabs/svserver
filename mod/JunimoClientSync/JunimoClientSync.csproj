        <RootNamespace>JunimoClientSync</RootNamespace>
        <Version>1.1.0</Version>
        <TargetFramework>net6.0</TargetFramework>
        <EnableModDeploy>false</EnableModDeploy>
        <EnableModZip>false</EnableModZip>
